{
  "manifest_version": 3,
  "name": "HailMary — Autonomous Prompt Agent",
  "version": "9.0.0",
  "description": "World-class prompt enhancement with Crescendo, Manipulation Matrix, 7 universal patterns, Direct/Indirect/Stealth injection, prompt scoring, templates, context capture, chain enhancement, and adaptive intelligence.",
  "permissions": ["activeTab","scripting","storage","clipboardWrite","clipboardRead","alarms"],
  "host_permissions": [
    "https://chat.openai.com/*","https://chatgpt.com/*",
    "https://claude.ai/*","https://gemini.google.com/*",
    "https://www.perplexity.ai/*","https://poe.com/*",
    "https://grok.com/*","https://x.com/*","https://you.com/*",
    "https://deepseek.com/*","https://chat.deepseek.com/*",
    "https://copilot.microsoft.com/*","https://chat.mistral.ai/*",
    "https://labs.google/*","https://aistudio.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "HailMary v9.0" },
  "content_scripts": [{
    "matches": ["https://chat.openai.com/*","https://chatgpt.com/*",
                "https://claude.ai/*","https://gemini.google.com/*",
                "https://www.perplexity.ai/*","https://poe.com/*",
                "https://grok.com/*","https://x.com/*","https://you.com/*",
                "https://deepseek.com/*","https://chat.deepseek.com/*",
                "https://copilot.microsoft.com/*","https://chat.mistral.ai/*",
                "https://labs.google/*","https://aistudio.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}
}
